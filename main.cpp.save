int currentScene = 1;

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    if(currentScene == 1)
        displayCover();
    else if(currentScene == 2)
        displayInstruction();
    else if(currentScene == 3)
        displaySovo_view();
    else if(currentScene == 4)
        displayMahir();
    else if(currentScene == 5)
        Adisplay();
    else if(currentScene == 6) {
        kDisplay();
        kCat();
    }

    glutSwapBuffers();
}

void handleKeypressScene(unsigned char key, int x, int y)
{
    switch (key)
    {

     case '1':
        currentScene = 1;
        break;

        case '2':
        currentScene = 2;
        break;

    case '3':
        currentScene = 3;
        updateSoundSovo();
        break;

    case '4':
        currentScene = 4;
        soundMahir();
        break;

    case '5':
        currentScene=5;
        Asound();
        break;

        case '6':
        currentScene=6;
        ksound();
        break;



    }

    glutPostRedisplay();
}



void keyboard(unsigned char key, int x, int y)
{
    handleKeypressScene(key, x, y);

    if(currentScene == 3)
    {
        handleKeypressSovo(key, x, y);
    }
    else if(currentScene == 4)
    {
        handleKeypressBoatMahir(key, x, y);
    }

     else if(currentScene == 5)
    {
        ahandleKeypress(key,x,y);
    }

    else if(currentScene == 6)
    {
        kKeyboardInput(key,x,y);
    }







}

void specialKeyboard(int key, int x, int y)
{
    if(currentScene == 4)
    {
        SpecialInputMahir(key, x, y);
    }

    if(currentScene==6){
        kSpecialInput(key,x,y);
    }
}

void mouse(int button, int state, int x, int y)
{
    if(currentScene == 3)
    {
        handleMouseSovo(button, state, x, y);
    }

    if(currentScene == 5)
    {
        aHandleMouse(button, state, x, y);
    }

    if(currentScene == 6)
    {
        kMouseClick(button,state,x,y);
    }


}

//FARHAT MAHIR End


/* Main function: GLUT runs as a console application starting at main()  */

int main(int argc, char** argv)
{
	glutInit(&argc, argv);                 // Initialize GLUT
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);

	glutInitWindowSize(1280, 750);   // Set the window's initial width & height
	glutInitWindowPosition(80, 50);  // Set the window's initial position according to the monitor
	glutCreateWindow("Spring Season"); // Create a window with the given title

    glutDisplayFunc(display); // Register display callback handler for window re-paint

    //glutIdleFunc(display);
    glutSpecialFunc(specialKeyboard);

    glutKeyboardFunc(keyboard);
    glutMouseFunc(mouse);

// Scene 1 timers
    glutTimerFunc(1000, update, 0);
    glutTimerFunc(0, updateBoat, 0);
    soundMahir();


// Scene 2 timers
    glutTimerFunc(100, moveCar, 0);
    glutTimerFunc(1, moveSmallCar, 0);
    glutTimerFunc(1, moveSmallestCar, 0);
    glutTimerFunc(35, moveRain, 0);


    glutTimerFunc(0000, kUpdate, 0);

    //updateSoundSovo();
	glutMainLoop();           // Enter the event-processing loop
	return 0;
}

