//AYSWARJO START

GLfloat aBoatPosition = 0.0f;
GLfloat aBoatSpeed = 0.01f;
int aBoatPauseTime = 500;
GLfloat aBirdPosition = 0.0f;
GLfloat aBirdSpeed = 0.001f;
GLfloat manX = -0.33f;
GLfloat manY = -0.05f;
GLfloat manSpeedX = 0.001f;
GLfloat manSpeedY = -0.001f;
GLfloat m3X = 0.0f;
GLfloat m3Y =  0.0f;
GLfloat m3SpeedX = 0.0015f;
GLfloat m3SpeedY = 0.001f;

bool m3Reached = false;
bool goForward = true;
bool hasBucket = false;
bool bucketOnBoat = true;
bool startMan1 = false;
bool startMan3 = false;
bool birdFlying = false;
bool birdTimerRunning = false;
bool boatTimerRunning = false;

void aUpdate(int value)
{
    aBoatPosition = aBoatPosition + aBoatSpeed;

    if(aBoatPosition > 1.2f)
        aBoatPosition = 0.0f;

    glutPostRedisplay();
    glutTimerFunc(aBoatPauseTime, aUpdate, 0);
}

void aUpdate1(int value)
{
    if(!birdFlying)
    {
        birdTimerRunning = false;
        return;
    }

    aBirdPosition = aBirdPosition - aBirdSpeed;

    if(aBirdPosition < -1.2f)
        aBirdPosition = 0.0f;

    glutPostRedisplay();
    glutTimerFunc(50, aUpdate1, 0);
}

void aUpdateMan(int value)
{
    float aBoatTargetX = -0.02f;

    if(goForward)
    {
        manX += manSpeedX;
        manY += manSpeedY;

        if(manX >= aBoatTargetX - 0.05f)
        {
            hasBucket = true;
            bucketOnBoat = false;
            goForward = false;
        }
    }
    else
    {
        manX -= manSpeedX;
        manY -= manSpeedY;

        if(manX <= -0.33f)
        {
            manX = -0.33f;
            manY = -0.05f;
            goForward = true;
            hasBucket = false;
            bucketOnBoat = true;
        }
    }

    glutPostRedisplay();
    glutTimerFunc(16, aUpdateMan, 0);
}

void updateMan3(int value)
{
    float targetX = -0.99f;
    float targetY = -0.75f;

    if(!m3Reached)
    {
        m3X -= m3SpeedX;
        m3Y -= m3SpeedY;

        if(m3X <= targetX)
        {
            m3X = targetX;
            m3Y = targetY;
            m3Reached = true;
        }
    }

    glutPostRedisplay();

    if(!m3Reached) {
        glutTimerFunc(16, updateMan3, 0);
    }
}

void renderBitmapString(float x, float y, float z, void *font, char *string) {
    char *c;
    glRasterPos3f(x, y,z);
    for (c=string; *c != '\0'; c++)
    {
        glutBitmapCharacter(font, *c);
    }
}

void Circle(float cx, float cy, float r) {
    int segments = 200;
    glBegin(GL_TRIANGLE_FAN);
    glVertex2f(cx, cy);  // Center point
    for (int i = 0; i <= segments; i++) {
        glVertex2f(cx + (r * cosf(i * 2.0f * PI / segments)), cy + (r * sinf(i * 2.0f * PI / segments)));
    }
    glEnd();
}

void EmptyCircle(float cx, float cy, float r) {
    int segments = 200;
    glBegin(GL_LINE_LOOP);
    glVertex2f(cx, cy);  // Center point
    for (int i = 0; i <= segments; i++) {
        glVertex2f(cx + (r * cosf(i * 2.0f * PI / segments)), cy + (r * sinf(i * 2.0f * PI / segments)));
    }
    glEnd();
}

void SemiCircle(float cx, float cy, float r) {
    int segments = 200;
    glBegin(GL_TRIANGLE_FAN);
    glVertex2f(cx, cy);  // Center point
    for (int i = 0; i <= segments; i++) {
        glVertex2f(cx + (r * cosf(i * 1.0f * PI / segments)), cy + (r * sinf(i * 1.0f * PI / segments)));
    }
    glEnd();
}

