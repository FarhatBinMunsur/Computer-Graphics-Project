 void car()
 {


glPushMatrix();

        glScalef(1.0f, 1.0f, 1.0f);

        glTranslatef(carPosition, 0.04f, 0.0f);


glColor3f(1.0f, 1.0f, 0.0f);  // Bright yellow
glBegin(GL_POLYGON);
    glVertex2f(-0.44f, -0.13f);   // U1 - Intersect(i, k)
    glVertex2f(-0.56f, -0.13f);  // V1 - Point(i)
    glVertex2f(-0.54f, -0.36f);  // W1 - Intersect(h, n)
    glVertex2f(+0.11f, -0.36f);  // Z1 - Point(n)
    glVertex2f(0.06f, -0.13f);   // A2 - Point(p)
    glVertex2f(-0.06f, -0.13f);   // B2 - Intersect(m, q)
    glVertex2f(-0.16f, 0.10f);   // C2 - Point(l)
    glVertex2f(-0.36f, 0.10f);    // D2 - Point(l)
glEnd();


glColor3f(0.0f, 0.0f, 0.0f);
glBegin(GL_QUADS);
    glVertex2f(-0.08f, -0.13f);   // U1 - Intersect(i, k)
    glVertex2f(-0.24f, -0.13f);  // V1 - Point(i)
    glVertex2f(-0.24f, 0.06f);  // W1 - Intersect(h, n)
    glVertex2f(-0.15f, 0.06f);  // Z1 - Point(n)
    glEnd();


    glBegin(GL_QUADS);
    glVertex2f(-0.26f, 0.06f);   // U1 - Intersect(i, k)
    glVertex2f(-0.26f, -0.13f);  // V1 - Point(i)
    glVertex2f(-0.41f, -0.13f);  // W1 - Intersect(h, n)
    glVertex2f(-0.36f, 0.06f);  // Z1 - Point(n)
    glEnd();

glPushMatrix();
glTranslatef(-0.4f, -0.36f, 0.0f);
glRotatef(wheelAngle, 0, 0, 1);
glTranslatef(0.4f, 0.36f, 0.0f);
CircleDr(-0.4f, -0.36f, 0.08f, 50, 0.0f, 0.0f, 0.0f);
CircleDr(-0.4f, -0.36f, 0.06f, 50, 1.0f, 1.0f, 1.0f);
glBegin(GL_LINES);
glColor3f(0,0,0);
glVertex2f(-0.46f, -0.36f);
glVertex2f(-0.34f, -0.36f);

glVertex2f(-0.4f, -0.42f);
glVertex2f(-0.4f, -0.3f);


glEnd();
glPopMatrix();

glPushMatrix();
glTranslatef(-0.03f, -0.36f, 0.0f);
glRotatef(wheelAngle, 0, 0, 1);
glTranslatef(0.03f, 0.36f, 0.0f);
CircleDr(-0.03f, -0.36f, 0.08f, 50, 0.0f, 0.0f, 0.0f);
CircleDr(-0.03f, -0.36f, 0.06f, 50, 1.0f, 1.0f, 1.0f);
glBegin(GL_LINES);
glColor3f(0,0,0);
glVertex2f(-0.09f, -0.36f);
glVertex2f(0.03f, -0.36f);

glVertex2f(-0.03f, -0.42f);
glVertex2f(-0.03f, -0.3f);


glEnd();
glPopMatrix();

glPopMatrix();

 }




void drawCloudsovo(float x, float y)
{




    float r = 199.0f/255.0f, g = 196.0f/255.0f, b = 191.0f/255.0f;


    CircleDr(x, y, 0.08f, 50, r, g, b);


    CircleDr(x - 0.08f, y, 0.06f, 50, r, g, b);
    CircleDr(x - 0.14f, y + 0.02f, 0.05f, 50, r, g, b);


    CircleDr(x + 0.08f, y, 0.06f, 50, r, g, b);
    CircleDr(x + 0.14f, y + 0.02f, 0.05f, 50, r, g, b);


    CircleDr(x, y + 0.06f, 0.06f, 50, r, g, b);
}

