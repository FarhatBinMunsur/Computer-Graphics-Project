void kDrawFootballPattern() {
    glColor3ub(0, 0, 0);
    kCircle(0.0f, 0.0f, 0.018f);

    glLineWidth(2.0f);
    glBegin(GL_LINES);
    glVertex2f(0.0f, 0.018f);
    glVertex2f(0.0f, 0.058f);
    glVertex2f(0.018f, 0.006f);
    glVertex2f(0.052f, 0.030f);
    glVertex2f(0.011f, -0.015f);
    glVertex2f(0.038f, -0.048f);
    glVertex2f(-0.011f, -0.015f);
    glVertex2f(-0.038f, -0.048f);
    glVertex2f(-0.018f, 0.006f);
    glVertex2f(-0.052f, 0.030f);
    glEnd();

    kCircle(0.0f, 0.058f, 0.010f);
    kCircle(0.052f, 0.030f, 0.010f);
    kCircle(0.038f, -0.048f, 0.010f);
    kCircle(-0.038f, -0.048f, 0.010f);
    kCircle(-0.052f, 0.030f, 0.010f);
}

void kFootball() {
    glPushMatrix();
    glTranslatef(footballX, footballY, 0.0f);
    glRotatef(footballAngle, 0.0f, 0.0f, 1.0f);

    glColor3ub(255, 255, 255);
    kCircle(0.0f, 0.0f, footballRadius);

    glColor3ub(0, 0, 0);
    glLineWidth(2.0f);
    glBegin(GL_LINE_LOOP);
    int segments = 120;
    for (int i = 0; i < segments; i++) {
        float angle = i * 2.0f * PI / segments;
        glVertex2f(footballRadius * cosf(angle), footballRadius * sinf(angle));
    }
    glEnd();

    glPushMatrix();
    glScalef(footballRadius / 0.065f, footballRadius / 0.065f, 1.0f);
    kDrawFootballPattern();
    glPopMatrix();

    glPopMatrix();
}

void kDrawCatLeg(float x, float swing) {
    glLineWidth(4.0f);
    glBegin(GL_LINES);
    glVertex2f(x, -0.035f);
    glVertex2f(x + swing, -0.115f);
    glEnd();
}

void kCat() {
    float frontSwing = 0.018f * sinf(catLegPhase);
    float backSwing = -frontSwing;

    glPushMatrix();
    glTranslatef(catX, -0.73f, 0.0f);
    glScalef(0.88f, 0.88f, 1.0f);

    glColor3ub(184, 99, 45);
    glBegin(GL_QUADS);
    glVertex2f(-0.055f, 0.040f);
    glVertex2f(0.060f, 0.040f);
    glVertex2f(0.060f, -0.045f);
    glVertex2f(-0.055f, -0.045f);
    glEnd();

    kCircle(-0.055f, 0.0f, 0.043f);
    kCircle(0.060f, 0.0f, 0.043f);
    kCircle(-0.105f, 0.035f, 0.045f);

    glBegin(GL_TRIANGLES);
    glVertex2f(-0.132f, 0.068f);
    glVertex2f(-0.120f, 0.118f);
    glVertex2f(-0.100f, 0.074f);

    glVertex2f(-0.105f, 0.075f);
    glVertex2f(-0.078f, 0.115f);
    glVertex2f(-0.073f, 0.065f);
    glEnd();

    glColor3ub(245, 225, 185);
    kCircle(-0.120f, 0.020f, 0.020f);

    glColor3ub(255, 248, 210);
    kCircle(-0.120f, 0.052f, 0.006f);
    kCircle(-0.090f, 0.052f, 0.006f);

    glColor3ub(0, 0, 0);
    kCircle(-0.121f, 0.052f, 0.0025f);
    kCircle(-0.091f, 0.052f, 0.0025f);

    glColor3ub(90, 45, 25);
    glLineWidth(1.0f);
    glBegin(GL_LINES);
    glVertex2f(-0.107f, 0.022f);
    glVertex2f(-0.112f, 0.014f);
    glVertex2f(-0.112f, 0.014f);
    glVertex2f(-0.100f, 0.014f);
    glEnd();

    glColor3ub(184, 99, 45);
    kDrawCatLeg(-0.040f, backSwing);
    kDrawCatLeg(-0.010f, frontSwing);
    kDrawCatLeg(0.025f, backSwing);
    kDrawCatLeg(0.050f, frontSwing);

    glColor3ub(210, 125, 63);
    glLineWidth(5.0f);
    glBegin(GL_LINE_STRIP);
    glVertex2f(0.085f, 0.025f);
    glVertex2f(0.120f, 0.080f);
    glVertex2f(0.100f, 0.125f);
    glEnd();

    glPopMatrix();
}




