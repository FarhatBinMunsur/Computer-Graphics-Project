void kLamp(){
    glColor3ub(0, 0, 0);
    glBegin(GL_QUADS);
    glVertex2f(-0.43f, -0.74f);
    glVertex2f(-0.43f, -0.44f);
    glVertex2f(-0.39f, -0.44f);
    glVertex2f(-0.39f, -0.74f);
    glEnd();

    glColor3ub(0, 0, 0);
    glLineWidth(4.5f);
    glBegin(GL_LINES);
    glVertex2f(-0.41f, -0.44f);
