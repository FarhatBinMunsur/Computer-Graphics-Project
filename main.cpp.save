void ahandleKeypress(unsigned char key, int x, int y)
{
    switch (key)
    {
    case 'c':
        if(startMan1)
            break;

        m3X = 0.0f;
        m3Y = 0.0f;
        m3Reached = false;
        startMan3 = false;
        startMan1 = true;
        bucketOnBoat = true;
        break;

    case 's':
        if(startMan3 && !m3Reached)
            break;

        startMan1 = false;

        manX = -0.33f;
        manY = -0.05f;

        goForward = true;
        hasBucket = false;
        bucketOnBoat = true;

        m3Reached = false;
        startMan3 = true;

        break;
    }

    glutPostRedisplay();
}

void startBird()
{
    birdFlying = true;
    mciSendStringA("play birdSound from 0 repeat", NULL, 0, NULL);

    if(!birdTimerRunning)
    {
        birdTimerRunning = true;
        glutTimerFunc(0, aUpdate1, 0);
    }
}

void stopBird()
{
    birdFlying = false;
    mciSendStringA("stop birdSound", NULL, 0, NULL);
}

void aHandleMouse(int button, int state, int x, int y)
{
    if(state == GLUT_DOWN)
    {
        if(button == GLUT_LEFT_BUTTON)
        {
            if(!boatTimerRunning)
            {
                boatTimerRunning = true;
                glutTimerFunc(0, aUpdate, 0);
            }

            if(birdFlying)
                stopBird();
            else
                startBird();
        }

        if(button == GLUT_RIGHT_BUTTON)
        {
            startBird();
        }
    }

    glutPostRedisplay();
}



void Asound()
{
    PlaySound("river.wav", NULL, SND_ASYNC|SND_FILENAME);
}

void Adisplay() {
    glClearColor(1.0f, 1.0f, 1.0f, 1.0f); // Set background color to black and opaque
    //glClear(GL_COLOR_BUFFER_BIT); // Clear the color buffer (background)

    aSky();
    aGround();
    aRiver();
    aBucket2();
    aBoat1();

    if(bucketOnBoat)
        aBucket1();

    aSun();

    glPushMatrix();
    glTranslatef(-0.49f, 0.35f, 0.0f);
    aBucket1();
    glPopMatrix();

    glPushMatrix();
    glTranslatef(0.02f, 0.66f, 0.0f);
    aBucket1();
    glPopMatrix();

    glPushMatrix();
    glTranslatef(-0.29f, 0.35f, 0.0f);
    aBucket2();
    glPopMatrix();

    glPushMatrix();
    glTranslatef(aBirdPosition, 0.0f, 0.0f);
    aBirds();
    glPopMatrix();

    Tent_Object();

    glPushMatrix();
    glTranslatef(-0.52f, -0.18f, 0.0f);
    Tent_Object();
    glPopMatrix();

    glPushMatrix();
    glTranslatef(-0.73f, -0.18f, 0.0f);
    Tent_Object();
    glPopMatrix();

    glPushMatrix();
    glTranslatef(aBoatPosition, 0.0f, 0.0f);
    aBoat2();
    glPopMatrix();

    aTree();
    aTents();
    aHouse();
    Man2();

   // Man1 Movement
    glPushMatrix();

    glTranslatef(manX + 0.33f, manY + 0.05, 0.0f);
    Man1();
    glPopMatrix();

    if(hasBucket){
    glPushMatrix();
    glTranslatef(manX - 0.2f, manY + 0.39f, 0.0f);
    aBucket1();
    glPopMatrix();
    }

    // Man3 Movement
    glPushMatrix();
    glTranslatef(m3X, m3Y, 0.0f);
    Man3();
    glPopMatrix();

if(startMan1)
{
    float aBoatTargetX = -0.02f;

    if(goForward)
    {
        manX += manSpeedX;
        manY += manSpeedY;

        if(manX >= aBoatTargetX - 0.05f)
        {
            hasBucket = true;
            bucketOnBoat = false;
            goForward = false;
        }
    }
    else
    {
        manX -= manSpeedX;
        manY -= manSpeedY;

        if(manX <= -0.33f)
        {
            manX = -0.33f;
            manY = -0.05f;
            goForward = true;
            hasBucket = false;
            bucketOnBoat = true;
        }
    }
}

if(startMan3 && !m3Reached)
{
    float targetX = -0.99f;
    float targetY = -0.75f;

    m3X -= m3SpeedX;
    m3Y -= m3SpeedY;

    if(m3X <= targetX && m3Y <= targetY)
    {
        m3X = targetX;
        m3Y = targetY;
        m3Reached = true;
    }
}

    glFlush(); // Render now
}

//AYSWARJO END


//SAMIA START

GLfloat position = 0.0f;
GLfloat speed = 0.006f;
GLfloat footballX = -1.08f;
GLfloat footballY = -0.70f;
GLfloat footballSpeed = 0.035f;
GLfloat footballAngle = 0.0f;
bool footballActive = false;
const GLfloat footballRadius = 0.045f;
GLfloat catX = 1.15f;
GLfloat catLegPhase = 0.0f;
GLfloat catTailPhase = 0.0f;
bool isNight = false;
GLfloat nightAmount = 0.0f;
GLfloat nightTarget = 0.0f;

void kRawColor(GLubyte r, GLubyte g, GLubyte b)
{
    ::glColor3ub(r, g, b);
}

GLubyte kBlendByte(GLubyte dayValue, GLubyte nightValue)
{
    return (GLubyte)(dayValue + (nightValue - dayValue) * nightAmount);
}

void kBlendColor(GLubyte dayR, GLubyte dayG, GLubyte dayB, GLubyte nightR, GLubyte nightG, GLubyte nightB)
{
    kRawColor(kBlendByte(dayR, nightR), kBlendByte(dayG, nightG), kBlendByte(dayB, nightB));
}

void kSetSceneColor(GLubyte r, GLubyte g, GLubyte b)
{
    if(nightAmount <= 0.0f)
    {
        kRawColor(r, g, b);
        return;
    }

    if(r == 211 && g == 242 && b == 247)
        kBlendColor(r, g, b, 11, 19, 46);
    else if(r == 178 && g == 255 && b == 166)
        kBlendColor(r, g, b, 23, 73, 49);
    else if(r == 249 && g == 220 && b == 181)
        kBlendColor(r, g, b, 86, 78, 82);
    else if(r == 178 && g == 219 && b == 211)
        kBlendColor(r, g, b, 50, 82, 92);
    else if(r == 145 && g == 190 && b == 181)
        kBlendColor(r, g, b, 36, 62, 72);
    else if(r == 196 && g == 219 && b == 214)
        kBlendColor(r, g, b, 220, 245, 255);
    else if(r == 225 && g == 245 && b == 250)
        kBlendColor(r, g, b, 220, 245, 255);
    else if(r == 122 && g == 253 && b == 137)
        kBlendColor(r, g, b, 27, 97, 58);
    else if(r == 111 && g == 232 && b == 135)
        kBlendColor(r, g, b, 22, 82, 51);
    else if(r == 63 && g == 179 && b == 68)
        kBlendColor(r, g, b, 22, 89, 47);
    else if(r == 80 && g == 198 && b == 75)
        kBlendColor(r, g, b, 32, 112, 57);
    else if(r == 80 && g == 48 && b == 28)
        kBlendColor(r, g, b, 38, 25, 22);
    else if(r == 190 && g == 190 && b == 185)
        kBlendColor(r, g, b, 255, 224, 126);
    else if(r == 244 && g == 190 && b == 103)
        kBlendColor(r, g, b, 255, 224, 126);
    else if(r > 230 && g > 230 && b > 230)
        kBlendColor(r, g, b, 164, 174, 195);
    else if(r == 0 && g == 0 && b == 0)
        kBlendColor(r, g, b, 4, 4, 7);
    else
        kBlendColor(r, g, b, (GLubyte)(r * 0.30f + 8), (GLubyte)(g * 0.34f + 12), (GLubyte)(b * 0.55f + 32));
}

#define glColor3ub kSetSceneColor

void kUpdate(int value)
{
    if(position > 1.5)
        position = -1.0f;

    position = position + speed;

    if(nightAmount < nightTarget)
    {
        nightAmount = nightAmount + 0.025f;
        if(nightAmount > nightTarget)
            nightAmount = nightTarget;
    }
    else if(nightAmount > nightTarget)
    {
        nightAmount = nightAmount - 0.025f;
        if(nightAmount < nightTarget)
            nightAmount = nightTarget;
    }

    if(footballActive)
    {
        footballX = footballX + footballSpeed;

        if(footballX + footballRadius >= -0.43f && footballSpeed > 0.0f)
            footballSpeed = -footballSpeed;

        if(footballX + footballRadius < -1.0f && footballSpeed < 0.0f)
            footballActive = false;

        footballAngle = footballAngle - (footballSpeed * 850.0f);
        if(footballAngle >= 360.0f)
            footballAngle = footballAngle - 360.0f;
        if(footballAngle <= -360.0f)
            footballAngle = footballAngle + 360.0f;
    }

    catX = catX - 0.01f;
    if(catX < -1.25f)
        catX = 1.15f;

    catLegPhase = catLegPhase + 0.3f;
    if(catLegPhase > 6.2832f)
        catLegPhase = 0.0f;

    catTailPhase = catTailPhase + 0.01f;
    if(catTailPhase > 6.2832f)
        catTailPhase = 0.0f;

	glutPostRedisplay();
	glutTimerFunc(100, kUpdate, 0);
}

void kSpecialInput(int key, int x, int y)
{
switch(key)
    {
    case GLUT_KEY_UP:
    speed += 0.1f;
    break;
    case GLUT_KEY_DOWN:
    speed -= 0.1f;
    break;
    case GLUT_KEY_LEFT:
    break;
    case GLUT_KEY_RIGHT:
    break;
    }
glutPostRedisplay();
}

void kMouseClick(int button, int state, int x, int y)
{
    if(button == GLUT_LEFT_BUTTON && state == GLUT_DOWN)
    {
        footballX = -1.08f;
        footballSpeed = 0.035f;
        footballAngle = 0.0f;
        footballActive = true;
        glutPostRedisplay();
    }
}

void kKeyboardInput(unsigned char key, int x, int y)
{
    switch(key)
    {
    case 'n':
    case 'N':
        isNight = !isNight;
        if(isNight)
            nightTarget = 1.0f;
        else
            nightTarget = 0.0f;
        break;
    case 27:
        exit(0);
        break;
    }
    glutPostRedisplay();
}

//const float PI = 3.1416f;

void kCircle(float cx, float cy, float r) {
    int segments = 200;
    glBegin(GL_TRIANGLE_FAN);
    glVertex2f(cx, cy);  // Center point
    for (int i = 0; i <= segments; i++) {
        glVertex2f(cx + (r * cosf(i * 2.0f * PI / segments)), cy + (r * sinf(i * 2.0f * PI / segments)));
    }
    glEnd();
}

void kSemiCircle(float cx, float cy, float r) {

    int segments = 200;

    glBegin(GL_TRIANGLE_FAN);

    glVertex2f(cx, cy);  // Center point

    for (int i = 0; i <= segments; i++) {

        glVertex2f(cx + (r * cosf(i * 1.0f * PI / segments)), cy + (r * sinf(i * 1.0f * PI / segments)));

    }

    glEnd();

}


void kDrawSemiCircleFromPoints(float x1, float y1, float x2, float y2, int) {
    float cx = (x1 + x2) / 2.0f;
    float cy = (y1 + y2) / 2.0f;
    float dx = (x2 - x1);
    float dy = (y2 - y1);
    float r = sqrt(dx * dx + dy * dy) / 2.0f;

    int num_segments = 200;
    glBegin(GL_TRIANGLE_FAN);
    glVertex2f(cx, cy);  // Center point

    // Draw semi-circle (0 to PI for semi-circle)
    for (int i = 0; i <= num_segments; i++) {
        float angle = i * PI / (num_segments / 2);  // Half circle (0 to PI)
        glVertex2f(cx + (r * cosf(angle)), cy + (r * sinf(angle)));
    }

    glEnd();
}

