//FARHAT MAHIR Start


void soundMahir()
{
    PlaySound("nature.wav", NULL, SND_ASYNC|SND_FILENAME);
}


void soundMahirMute()
{
    PlaySound(NULL, NULL, 0);
        return;
}


float cloudX1 = 0.0f;
float cloudX2 = 0.0f;
float y=0.0f;



void drawCloud()
{
    glPushMatrix();

    glTranslatef(cloudX1,- 0.25f, 0.0f);

    GLfloat c1x = -0.42f;
    GLfloat c1y = 0.75f;
    GLfloat r = 0.08f;
    int triangleAmount=100;

    CircleDr(c1x, c1y, r, triangleAmount, 0.95f, 0.95f, 0.95f);

    CircleDr(c1x + 0.08f, c1y + 0.04f, r, triangleAmount, 0.95f, 0.95f, 0.95f);

    CircleDr(c1x + 0.16f, c1y, r, triangleAmount, 0.95f, 0.95f, 0.95f);

    glPopMatrix();
}

void drawCloud2(){
glPushMatrix();


glTranslatef(cloudX2, 0.0f, 0.0f);

GLfloat c2x = -0.15f;
GLfloat c2y = 0.60f;
GLfloat r2  = 0.05f;
int triangleAmount=100;


CircleDr(c2x, c2y, r2, triangleAmount, 0.95f, 0.95f, 0.95f);
CircleDr(c2x + 0.06f, c2y + 0.03f, r2, triangleAmount, 0.95f, 0.95f, 0.95f);
CircleDr(c2x + 0.12f, c2y, r2, triangleAmount, 0.95f, 0.95f, 0.95f);
CircleDr(c2x + 0.06f, c2y - 0.03f, r2, triangleAmount, 0.95f, 0.95f, 0.95f);

glPopMatrix();
}

void updateCloud()
{

    cloudX1 += 0.0008f;

    cloudX2 -= 0.0007f;

    if(cloudX1 > 1.5f) {
        cloudX1 = -1.5f;

    }

    if(cloudX2 < -1.5f) {
        cloudX2 = 1.5f;
    }
}


//BirdsMahir
GLfloat birdX = -0.2f;
GLfloat birdY = 0.1f;
GLfloat Birdspeed = 0.0003f;

void drawBirdMahir()
{
    glLineWidth(3);
    glColor3f(0.0f, 0.0f, 0.0f);

    // Bird 1
    glBegin(GL_LINE_STRIP);
    glVertex2f(-0.01f + birdX, 0.85f + birdY);
    glVertex2f( 0.01f + birdX, 0.83f + birdY);
    glVertex2f( 0.03f + birdX, 0.85f + birdY);
    glEnd();

    // Bird 2
    glBegin(GL_LINE_STRIP);
    glVertex2f(-0.04f + birdX, 0.80f + birdY);
    glVertex2f(-0.02f + birdX, 0.78f + birdY);
    glVertex2f( 0.00f + birdX, 0.80f + birdY);
    glEnd();

    // Bird 3
    glBegin(GL_LINE_STRIP);
    glVertex2f(-0.04f + birdX, 0.84f + birdY);
    glVertex2f(-0.06f + birdX, 0.82f + birdY);
    glVertex2f(-0.08f + birdX, 0.84f + birdY);
    glEnd();
}

void update(int value)
{
    birdX += Birdspeed;

    if(birdX > 1.5f)
        birdX = -1.5f;

    glutPostRedisplay();
    glutTimerFunc(1000, update, 0);
}


float boatX = -1.3f;
float boatY = 0.27f;
float btspeedX = 0.00001f;
float btspeedY = 0.000005f;



void drawBoatMahir() {

glColor3f(0.0f, 0.0f, 0.0f);
glBegin(GL_POLYGON);
    glVertex2f(0.30f + boatX, -0.26f + boatY);
    glVertex2f(0.48f + boatX, -0.26f + boatY);
    glVertex2f(0.44f + boatX, -0.32f + boatY);
    glVertex2f(0.34f + boatX, -0.32f + boatY);
glEnd();

  glBegin(GL_LINES);
    glVertex2f(0.39f + boatX, -0.26f + boatY);
    glVertex2f(0.39f + boatX, -0.05f + boatY);
glEnd();

glColor3f(1.0f, 1.0f, 1.0f);
glBegin(GL_TRIANGLES);
    glVertex2f(0.39f + boatX, -0.05f + boatY);
    glVertex2f(0.39f + boatX, -0.20f + boatY);
    glVertex2f(0.48f + boatX, -0.15f + boatY);
glEnd();


}

bool boatMoving = false;

void updateBoat(int value)
{
    if(boatMoving)
    {
        // move -0.2X
        if(boatX < -0.2f)
            boatX += btspeedX;

        if(boatX > -0.2f)
        {
            boatX += 0.0000016f;
            boatY -= btspeedY;
        }

        if(boatY < -1.0f)
        {
            boatX = -1.3f;
            boatY = 0.27f;
        }
    }

    glutPostRedisplay();
    glutTimerFunc(100, updateBoat, 0);
}

void handleKeypressBoatMahir(unsigned char key, int x, int y)
{
    switch(key)
    {
        case 'g':
            boatMoving = true;   // start moving
            break;

        case 's':
            boatMoving = false;  // stop moving
            break;

        case 'm':
            soundMahirMute();
            break;

        case 'u':
            soundMahir();
            break;
    }

    glutPostRedisplay();
}


void SpecialInputMahir(int key, int x, int y)
{
    switch(key)
    {
        case GLUT_KEY_UP:
            birdY += 0.05f;   // up
            break;

        case GLUT_KEY_DOWN:
            if(birdY < 0.001f)
                birdY = 0.001f;
            else birdY -= 0.05f;   // down


            break;

            case GLUT_KEY_LEFT:
            Birdspeed -= 0.0002f;
            if(Birdspeed < 0.00005f) Birdspeed = 0.00005f;
            break;

        case GLUT_KEY_RIGHT:
            Birdspeed += 0.0002f;
            if(Birdspeed > 0.02f)   // max speed
                Birdspeed = 0.02f;
            break;

    }

    glutPostRedisplay();
}





