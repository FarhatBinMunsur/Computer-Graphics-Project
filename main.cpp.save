void kdrawNightSkyDetails()
{
    if(nightAmount <= 0.0f)
        return;

    kBlendColor(211, 242, 247, 245, 238, 190);
    kCircle(0.74f, 0.78f, 0.08f);

    kBlendColor(211, 242, 247, 11, 19, 46);
    kCircle(0.78f, 0.81f, 0.08f);

    kBlendColor(211, 242, 247, 238, 241, 255);
    kCircle(-0.88f, 0.87f, 0.009f);
    kCircle(-0.63f, 0.82f, 0.007f);
    kCircle(-0.38f, 0.91f, 0.008f);
    kCircle(-0.18f, 0.77f, 0.006f);
    kCircle(0.07f, 0.90f, 0.008f);
    kCircle(0.31f, 0.83f, 0.006f);
    kCircle(0.52f, 0.93f, 0.007f);
    kCircle(0.92f, 0.88f, 0.008f);
}

void kdrawSunTransition()
{
    if(nightAmount >= 1.0f)
        return;

    float sunY = 0.78f - (nightAmount * 0.72f);
    kBlendColor(255, 214, 86, 244, 117, 70);
    kCircle(-0.74f, sunY, 0.075f);
}

