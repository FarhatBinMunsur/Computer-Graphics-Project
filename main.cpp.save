#include <windows.h>  // for MS Windows
#include <GL/glut.h>  // GLUT, include glu.h and gl.h
#include<math.h>
# define PI  3.14159265358979323846

/* Handler for window-repaint event. Call back when the window first appears and
whenever the window needs to be re-painted. */

void CircleDr(GLfloat x,GLfloat y,GLfloat r,int amt,GLfloat re,GLfloat g,GLfloat b){


	int triangleAmount =amt;

	//GLfloat radius = 0.8f; //radius
	GLfloat twicePi = 2.0f * PI;

	glColor3f(re, g, b);
	glBegin(GL_TRIANGLE_FAN);
		glVertex2f(x, y); // center of circle
		for(int i = 0; i <= triangleAmount;i++) {
			glVertex2f( x + (r * cos(i *  twicePi / triangleAmount)),
                        y + (r * sin(i * twicePi / triangleAmount)) );
		}
	glEnd();
}

void CircleDrHalf(GLfloat x,GLfloat y,GLfloat r,int amt,GLfloat re,GLfloat g,GLfloat b){


	int triangleAmount =amt;

	//GLfloat radius = 0.8f; //radius
	GLfloat twicePi = 2.0f * PI;

	glColor3f(re, g, b);
	glBegin(GL_TRIANGLE_FAN);
		glVertex2f(x, y); // center of circle
		for(int i = 0; i <= triangleAmount;i++) {
			glVertex2f( x + (r * cos(i *  twicePi / triangleAmount)),
                        y + (r * sin(i * twicePi / triangleAmount)) );
		}
	glEnd();
}



GLboolean isDay = GL_FALSE;
GLfloat carPosition = -0.4f;
GLfloat smallCarPosition = -1.2f;
GLfloat smallestCarPosition = -0.1f;
GLfloat carSpeed = 0.01f;
GLfloat wheelAngle = 0.0f;
GLfloat rainY = 0.0f;
GLfloat rainSpeed = 0.5f;
GLboolean showRain = GL_FALSE;
GLboolean soundOn = GL_TRUE;

  void updateSoundSovo()
{
    if(!soundOn)
    {
        PlaySound(NULL, NULL, 0);
        return;
    }

    if(showRain)
    {
        PlaySound("liecio-calming-rain-257596.wav", NULL, SND_ASYNC | SND_FILENAME | SND_LOOP);
    }
    else
    {
        PlaySound("photos-cars-passing-by-407762", NULL, SND_ASYNC | SND_FILENAME | SND_LOOP);
    }
}

void handleKeypressSovo(unsigned char key, int x, int y)
{
    switch(key)
    {
        case '+':
        case '=':
            carSpeed += 0.005f;
            if(carSpeed > 0.1f) carSpeed = 0.1f;
            break;

        case '-':
            carSpeed -= 0.005f;
            if(carSpeed < 0.001f) carSpeed = 0.001f;
            break;

        case 'm':
            soundOn = GL_FALSE;
            updateSoundSovo();
            break;

        case 'u':
            soundOn = GL_TRUE;
            updateSoundSovo();
            break;

        case 'd':
            isDay = !isDay;
            break;
    }

    glutPostRedisplay();
}


void handleMouseSovo(int button, int state, int x, int y)
{
    if(state == GLUT_DOWN)
    {
        if(button == GLUT_RIGHT_BUTTON)
        {
            showRain = GL_TRUE;
        }
        else if(button == GLUT_LEFT_BUTTON)
        {
            showRain = GL_FALSE;
        }

        updateSoundSovo();
    }

    glutPostRedisplay();
}



void moveRain(int value)
{
    rainY -= rainSpeed;

    if(rainY < -2.0f)
        rainY = 0.7f;

    glutPostRedisplay();
    glutTimerFunc(35, moveRain, 0);
}


 void moveCar(int value)
{
    carPosition += carSpeed;
     wheelAngle -= carSpeed * 100;

    if(carPosition > 1.0f)
        carPosition = -1.0f;

    glutPostRedisplay();
    glutTimerFunc(35, moveCar, 0);
}

 void moveSmallCar(int value)
{
    smallCarPosition += carSpeed;
     wheelAngle -= carSpeed * 100;
    if(smallCarPosition >3.0f) smallCarPosition = -2.5f;

    glutPostRedisplay();
    glutTimerFunc(15, moveSmallCar, 0);
}

void moveSmallestCar(int value)
{
    smallestCarPosition += carSpeed;
     wheelAngle -= carSpeed * 100;
    if(smallestCarPosition > 3.0f) smallestCarPosition = -2.5f;

    glutPostRedisplay();
    glutTimerFunc(15, moveSmallestCar, 0);
}

void rain()
{

    glColor3f(0.75f, 0.85f, 1.0f);

    glLineWidth(3.0f);

    int count = 100;
    float spacing = 2.0f / count;

    float slope = 0.25f;

    for(int i = 0; i < count; i++)
    {
        float x = -1.0f + i * spacing;

        glBegin(GL_LINES);
            glVertex2f(x, 0.7f + rainY);
            glVertex2f(x + slope, -1.0f + rainY);
        glEnd();
    }
}

